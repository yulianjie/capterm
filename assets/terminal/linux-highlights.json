{
  "rules": [
    {
      "scope": "prompt",
      "pattern": "([$#%>❯])\\s*$",
      "captures": { "1": "bright_magenta" }
    },
    {
      "scope": "command",
      "pattern": "(?:^|[|;&])\\s*(?:(sudo|doas|command|time|nice|nohup|stdbuf)\\s+)?([[:alpha:]_][[:alnum:]_.+-]*)",
      "captures": { "1": "bright_green", "2": "cyan" }
    },
    {
      "scope": "both",
      "pattern": "(?:^|[\\s\\[({|;&<>])(--?[[:alpha:]_][[:alnum:]_-]*)(=)([^\\s\"']+)?",
      "captures": { "1": "yellow", "2": "yellow", "3": "green" }
    },
    {
      "scope": "command",
      "pattern": "([[:alpha:]_][[:alnum:]_]*)(=)",
      "captures": { "1": "cyan", "2": "yellow" }
    },
    {
      "scope": "both",
      "pattern": "(?:^|[\\s\\[({|;&<>])(--?[[:alpha:]_][[:alnum:]_-]*)",
      "captures": { "1": "yellow" }
    },
    {
      "scope": "both",
      "pattern": "\\$\\{?[[:alpha:]_][[:alnum:]_]*(?:\\})?",
      "captures": { "0": "bright_cyan" }
    },
    {
      "scope": "both",
      "pattern": "\\\\(?:[abefnprtv'\"?\\\\]|[0-7]{1,3}|x[[:xdigit:]]{1,2}|u[[:xdigit:]]{1,4}|U[[:xdigit:]]{1,8})",
      "captures": { "0": "bright_yellow" }
    },
    {
      "scope": "both",
      "pattern": "%(?:[0-9]+\\$)?[-+ #0']*(?:[0-9]+|\\*)?(?:\\.[0-9]+)?(?:hh|h|ll|l|j|t|z|L)?[diuoxXDOUeEfFgGaAcCsSpn%]",
      "captures": { "0": "bright_magenta" }
    },
    {
      "scope": "both",
      "pattern": "'(?:[^'\\n]|\\\\.)*'",
      "captures": { "0": "yellow" }
    },
    {
      "scope": "both",
      "pattern": "\"(?:[^\"\\n]|\\\\.)*\"",
      "captures": { "0": "yellow" }
    },
    {
      "scope": "output",
      "pattern": "^\\s*([-bcCdDlMnpPs?])(?:-|([r]))(?:-|([w]))(?:-|([xsStT]))(?:-|([r]))(?:-|([w]))(?:-|([xsStT]))(?:-|([r]))(?:-|([w]))(?:-|([xsStT]))([.+]?)\\s",
      "captures": {
        "1": "bright_blue",
        "2": "green",
        "3": "yellow",
        "4": "red",
        "5": "green",
        "6": "yellow",
        "7": "red",
        "8": "green",
        "9": "yellow",
        "10": "red",
        "11": "bright_magenta"
      }
    },
    {
      "scope": "output",
      "pattern": "(?i)\\b(?:fatal|panic|critical|errors?|fail(?:ed|ure)?|denied|refused|invalid|incorrect|unsupported|deprecated|disabled|false|bad|wrong|cannot)\\b",
      "captures": { "0": "bright_red" }
    },
    {
      "scope": "output",
      "pattern": "(?i)\\b(?:ok|passed?|success(?:ful(?:ly)?)?|true|valid|enabled|supported|yes|correct(?:ly)?)\\b",
      "captures": { "0": "bright_green" }
    },
    {
      "scope": "output",
      "pattern": "(?i)\\b(?:warn(?:ing)?s?|timeout|timed out|retry(?:ing)?|skipped|closed|stopped|disconnected)\\b",
      "captures": { "0": "bright_yellow" }
    },
    {
      "scope": "output",
      "pattern": "(?i)\\b(?:debug|trace)\\b",
      "captures": { "0": "bright_magenta" }
    },
    {
      "scope": "output",
      "pattern": "(?i)\\b(?:info|notice|access|authentication|connection|disconnection|login|operation|password|permission)\\b",
      "captures": { "0": "bright_cyan" }
    },
    {
      "scope": "both",
      "pattern": "(?i)\\bhttps?://[^\\s<>()\\[\\]{}\"']+",
      "captures": { "0": "bright_cyan" }
    },
    {
      "scope": "both",
      "pattern": "\\b(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\b",
      "captures": { "0": "bright_cyan" }
    },
    {
      "scope": "both",
      "pattern": "(?i)\\b(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}\\b",
      "captures": { "0": "bright_cyan" }
    },
    {
      "scope": "both",
      "pattern": "(?i)(?:^|[^0-9a-f:])((?:(?:[0-9a-f]{1,4}:){0,6}[0-9a-f]{1,4})?::(?:[0-9a-f]{1,4}(?::[0-9a-f]{1,4}){0,5})?)(?:$|[^0-9a-f:])",
      "captures": { "1": "bright_cyan" }
    },
    {
      "scope": "both",
      "pattern": "(?i)\\b(?:[0-9a-f]{2}[:-]){5}[0-9a-f]{2}\\b",
      "captures": { "0": "bright_cyan" }
    },
    {
      "scope": "both",
      "pattern": "\\b\\d{4}[-/]\\d{1,2}[-/]\\d{1,2}(?:[ T]\\d{1,2}:\\d{2}(?::\\d{2}(?:\\.\\d{1,9})?)?(?:Z|[+-]\\d{2}:?\\d{2})?)?\\b",
      "captures": { "0": "bright_magenta" }
    },
    {
      "scope": "both",
      "pattern": "\\b\\d{1,2}[/-]\\d{1,2}[/-]\\d{2,4}\\b",
      "captures": { "0": "bright_magenta" }
    },
    {
      "scope": "both",
      "pattern": "\\b\\d{8}T\\d{6}(?:\\.\\d+)?Z?\\b",
      "captures": { "0": "bright_magenta" }
    },
    {
      "scope": "both",
      "pattern": "(?i)\\b\\d{1,2}:\\d{2}(?::\\d{2}(?:\\.\\d+)?)?(?:\\s?(?:AM|PM|UTC|GMT|Z))?\\b",
      "captures": { "0": "bright_magenta" }
    },
    {
      "scope": "both",
      "pattern": "(?i)\\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\\b",
      "captures": { "0": "bright_magenta" }
    },
    {
      "scope": "both",
      "pattern": "(?i)\\b(?:Mon|Tue|Tues|Wed|Thu|Thur|Fri|Sat|Sun)\\b",
      "captures": { "0": "bright_magenta" }
    },
    {
      "scope": "both",
      "pattern": "(?:^|[^[:alnum:]_])([[:alnum:]_./-]+\\.[[:alpha:]][[:alnum:]]*:[0-9]+(?::[0-9]+)?)(?:$|[^0-9])",
      "captures": { "1": "bright_blue" }
    },
    {
      "scope": "both",
      "pattern": "(?:~/|\\./|\\.\\./|/)[[:alnum:]_./~+@-]*|[[:alnum:]_-]+/[[:alnum:]_./~+@-]+",
      "captures": { "0": "blue" }
    },
    {
      "scope": "both",
      "pattern": "\\b0[xX][[:xdigit:]]+\\b",
      "captures": { "0": "magenta" }
    },
    {
      "scope": "both",
      "pattern": "\\b[0-9a-f]*[a-f][0-9a-f]{7,63}\\b",
      "captures": { "0": "magenta" }
    },
    {
      "scope": "both",
      "pattern": "\\b[0-9]+(?:,[0-9]{3})*(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?%?\\b",
      "captures": { "0": "magenta" }
    },
    {
      "scope": "both",
      "pattern": "(\\|\\||&&|\\|&|[|;&<>])",
      "captures": { "1": "bright_cyan" }
    },
    {
      "scope": "both",
      "pattern": "([()\\[\\]{}])",
      "captures": { "1": "bright_yellow" }
    }
  ]
}
